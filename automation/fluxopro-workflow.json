        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.FLUXOPRO_INTERNAL_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\":\"Falha\",\"erro\":\"Falha no workflow n8n; consultar execução.\"}",
