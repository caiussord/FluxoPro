{
  "name": "FluxoPro - orçamento demonstrativo",
  "nodes": [
    {
      "id": "webhook",
      "name": "Receber solicitação",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "fluxopro-solicitacao",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "claim",
      "name": "Iniciar uma vez",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.FLUXOPRO_API_URL + '/api/solicitacoes/' + $('Receber solicitação').first().json.body.id + '/iniciar'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.FLUXOPRO_INTERNAL_KEY}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "get",
      "name": "Consultar solicitação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "url": "={{$env.FLUXOPRO_API_URL + '/api/solicitacoes/' + $('Receber solicitação').first().json.body.id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.FLUXOPRO_INTERNAL_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "pdf",
      "name": "Gerar PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.FLUXOPRO_API_URL + '/api/solicitacoes/' + $('Receber solicitação').first().json.body.id + '/gerar-pdf'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.FLUXOPRO_INTERNAL_KEY}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "customer",
      "name": "Enviar confirmação",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1220,
        300
      ],
      "parameters": {
        "fromEmail": "={{$env.FLUXOPRO_FROM_EMAIL}}",
        "toEmail": "={{$('Consultar solicitação').first().json.email}}",
        "subject": "={{$('Consultar mensagens').first().json.cliente.assunto}}",
        "emailFormat": "text",
        "text": "={{$('Consultar mensagens').first().json.cliente.corpo}}",
        "options": {
          "attachments": "data"
        }
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "company",
      "name": "Avisar equipe",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "fromEmail": "={{$env.FLUXOPRO_FROM_EMAIL}}",
        "toEmail": "={{$env.FLUXOPRO_TEAM_EMAIL}}",
