        "emailFormat": "text",
        "text": "={{$('Consultar mensagens').first().json.equipe.corpo}}",
        "options": {}
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "done",
      "name": "Concluir",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        300
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.FLUXOPRO_API_URL + '/api/solicitacoes/' + $('Receber solicitação').first().json.body.id + '/status'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{$env.FLUXOPRO_INTERNAL_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\":\"Concluída\"}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
